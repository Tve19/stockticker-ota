def load_holidays():
    raw = load_json_file(HOLIDAYS_FILE, DEFAULT_HOLIDAYS)
    h = {"closed": [], "early_close": []}
    try:
        for d in raw.get("closed", []):
            d = clean_date(d)
            if len(d) == 10 and d not in h["closed"]:
                h["closed"].append(d)
        for d in raw.get("early_close", []):
            d = clean_date(d)
            if len(d) == 10 and d not in h["early_close"]:
                h["early_close"].append(d)
    except Exception:
        h = DEFAULT_HOLIDAYS
    return h


def read_symbols_file():
    try:
        with open(SYMBOLS_FILE, "r") as f:
            raw = f.read()
        symbols = []
        seen = []
        for line in raw.replace(",", "\n").split("\n"):
            s = clean_symbol(line)
            if s and s not in seen:
                symbols.append(s)
                seen.append(s)
        return symbols
    except Exception:
        return []


