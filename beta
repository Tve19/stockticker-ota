# ------------------------- helpers -------------------------

def copy_dict(d):
    out = {}
    for k in d:
        out[k] = d[k]
    return out


def html_escape(value):
    s = str(value)
    s = s.replace("&", "&amp;")
    s = s.replace("<", "&lt;")
    s = s.replace(">", "&gt;")
    s = s.replace('"', "&quot;")
    s = s.replace("'", "&#39;")
    return s


def url_decode(s):
    s = str(s).replace("+", " ")
    out = ""
    i = 0
    while i < len(s):
        if s[i] == "%" and i + 2 < len(s):
            try:
                out += chr(int(s[i + 1:i + 3], 16))
                i += 3
            except Exception:
                out += s[i]
                i += 1
        else:
            out += s[i]
            i += 1
    return out


def render_template(template, values):
    page = template
    for key in values:
        page = page.replace("[[" + key + "]]", str(values[key]))
    return page


def is_read_only_error(e):
    return "30" in repr(e) or "EROFS" in repr(e) or "read-only" in str(e).lower()


def filesystem_writable():
    try:
        with open(WRITE_TEST_FILE, "w") as f:
            f.write("ok")
        try:
            os.remove(WRITE_TEST_FILE)
        except Exception:
            pass
        return True, "Filesystem is writable by app.py."
    except Exception as e:
        if is_read_only_error(e):
            return False, "Filesystem is read-only to app.py. Install boot.py, restart, then do not boot in USB edit mode."
        return False, "Filesystem write test failed: " + repr(e)


def safe_write_text(path, text):
    try:
        gc.collect()
        with open(path, "w") as f:
            f.write(text)
        gc.collect()
        return True, "Saved " + path
    except Exception as e:
        if is_read_only_error(e):
            return False, "Cannot save " + path + ": filesystem is read-only to app.py. Use the included boot.py."
        return False, "Cannot save " + path + ": " + repr(e)


def load_json_file(path, default_value):
    try:
        with open(path, "r") as f:
            return json.load(f)
    except Exception as e:
        print("Using default for", path, repr(e))
        return default_value


def save_json_file(path, data):
    try:
        text = json.dumps(data)
    except Exception as e:
        return False, "JSON build failed for " + path + ": " + repr(e)
    return safe_write_text(path, text)


def clean_symbol(raw):
    raw = url_decode(str(raw)).strip().upper()
    raw = raw.replace("$", "")
    raw = raw.replace("SYMBOLS=", "")
    raw = raw.replace("SYMBOL=", "")
    allowed = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-"
    cleaned = ""
    for ch in raw:
        if ch in allowed:
            cleaned += ch
    return cleaned


def clean_text(raw):
    return url_decode(str(raw)).strip()


def clean_date(raw):
    raw = url_decode(str(raw)).strip()
    allowed = "0123456789-"
    cleaned = ""
    for ch in raw:
        if ch in allowed:
            cleaned += ch
    return cleaned


def bool_from_form(value):
    value = str(value).lower()
    return value in ("1", "true", "yes", "on")


def clamp_float(value, low, high, default_value):
    try:
        v = float(value)
    except Exception:
        v = float(default_value)
    if v < low:
        v = low
    if v > high:
        v = high
    return v


def clamp_int(value, low, high, default_value):
    try:
        v = int(float(value))
    except Exception:
        v = int(default_value)
    if v < low:
        v = low
    if v > high:
        v = high
    return v


def selected(value, current):
    if str(value) == str(current):
        return "selected"
    return ""

