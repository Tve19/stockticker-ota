def normalize_config(cfg):
    cfg["brightness"] = clamp_float(cfg.get("brightness"), 0.0, 1.0, DEFAULT_CONFIG["brightness"])
    cfg["night_brightness"] = clamp_float(cfg.get("night_brightness"), 0.0, 1.0, DEFAULT_CONFIG["night_brightness"])
    cfg["scroll_speed_open"] = clamp_float(cfg.get("scroll_speed_open"), 0.1, 5.0, DEFAULT_CONFIG["scroll_speed_open"])
    cfg["scroll_speed_closed"] = clamp_float(cfg.get("scroll_speed_closed"), 0.1, 5.0, DEFAULT_CONFIG["scroll_speed_closed"])
    cfg["fetch_interval_open"] = clamp_int(cfg.get("fetch_interval_open"), 5, 3600, DEFAULT_CONFIG["fetch_interval_open"])
    cfg["fetch_interval_pre_after"] = clamp_int(cfg.get("fetch_interval_pre_after"), 10, 3600, DEFAULT_CONFIG["fetch_interval_pre_after"])
    cfg["fetch_interval_closed"] = clamp_int(cfg.get("fetch_interval_closed"), 30, 7200, DEFAULT_CONFIG["fetch_interval_closed"])
    cfg["alert_percent_move"] = clamp_float(cfg.get("alert_percent_move"), 0.0, 100.0, DEFAULT_CONFIG["alert_percent_move"])
    cfg["block_gap"] = clamp_int(cfg.get("block_gap"), 0, 120, DEFAULT_CONFIG["block_gap"])
    cfg["scroll_delay"] = clamp_float(cfg.get("scroll_delay"), 0.005, 0.20, DEFAULT_CONFIG["scroll_delay"])
    cfg["night_start_hour"] = clamp_int(cfg.get("night_start_hour"), 0, 23, DEFAULT_CONFIG["night_start_hour"])
    cfg["night_end_hour"] = clamp_int(cfg.get("night_end_hour"), 0, 23, DEFAULT_CONFIG["night_end_hour"])
    cfg["admin_pin"] = str(cfg.get("admin_pin", DEFAULT_CONFIG["admin_pin"]))

    channel = str(cfg.get("update_channel", "stable")).lower()
